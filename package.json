{
  "name": "bk-billing",
  "version": "1.9.0",
  "description": "Broasted Kozhi Bill Hub Desktop Software",
  "author": "Broasted Kozhi",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:nsis": "vite build && electron-builder --win nsis",
    "electron:build:portable": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.broastedkozhi.billhub",
    "productName": "Broasted Kozhi Bill Hub",
    "copyright": "Copyright © 2026 Broasted Kozhi",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Rajesh4027",
      "repo": "Broasted_Kozhi"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "executableName": "BroastedKozhiBillHub",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.png"
    },
    "nsis": {
      "artifactName": "Broasted-Kozhi-Bill-Hub-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Broasted Kozhi Bill Hub",
      "uninstallDisplayName": "Broasted Kozhi Bill Hub App",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
